@page
@model IndexModel
@{
    ViewData["Title"] = "StreamFlix";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>StreamFlix</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>

            body{
                background:#141414;
                color:white;
                font-family:Arial,Helvetica,sans-serif;
            }

            .navbar{
                background:rgba(0,0,0,.8);
            }

            .navbar-brand{
                color:#e50914;
                font-size:34px;
                font-weight:bold;
            }

            .nav-link{
                color:white !important;
            }

            .hero{

                height:700px;

                background-image:
                linear-gradient(to top,#141414 5%,transparent 60%),
                url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba");

                background-size:cover;
                background-position:center;
            }

            .hero-content{

                padding-top:220px;
                max-width:650px;

            }

            .hero h1{
                font-size:70px;
                font-weight:bold;
            }

            .hero p{
                font-size:22px;
            }

            .btn-play{
                background:white;
                color:black;
                font-weight:bold;
            }

            .btn-info2{
                background:rgba(109,109,110,.7);
                color:white;
            }

            .movie-row{
                padding:20px;
            }

            .movie-card{

                transition:.3s;
                cursor:pointer;

            }

            .movie-card:hover{

                transform:scale(1.15);
                z-index:10;

            }

            .movie-card img{

                border-radius:6px;

            }

            .footer{

                padding:40px;
                color:gray;

            }

    </style>

</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">

        <div class="container-fluid">

            <a class="navbar-brand" href="#">STREAMFLIX</a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse" id="menu">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item"><a class="nav-link" href="#">Home</a></li>

                    <li class="nav-item"><a class="nav-link" href="#">TV Shows</a></li>

                    <li class="nav-item"><a class="nav-link" href="#">Movies</a></li>

                    <li class="nav-item"><a class="nav-link" href="#">New & Popular</a></li>

                    <li class="nav-item"><a class="nav-link" href="#">My List</a></li>

                </ul>

                <div>

                    <i class="bi bi-search fs-5 me-4"></i>

                    <i class="bi bi-bell fs-5 me-4"></i>

                    <img src="https://i.pravatar.cc/40"
                         class="rounded">

                </div>

            </div>

        </div>

    </nav>


    <section class="hero">

        <div class="container hero-content">

            <h1>THE LAST HORIZON</h1>

            <p>

                An epic science fiction adventure that follows a group of explorers
                searching for humanity's final hope beyond the stars.

            </p>

            <div class="mt-4">

                <button class="btn btn-play btn-lg">

                    <i class="bi bi-play-fill"></i>

                    Play

                </button>

                <button class="btn btn-info2 btn-lg ms-3">

                    <i class="bi bi-info-circle"></i>

                    More Info

                </button>

            </div>

        </div>

    </section>


    <div class="container-fluid movie-row">

        <h3>Trending Now</h3>

        <div class="row">

            @for (int i = 1; i <= 6; i++)
            {
                <div class="col-lg-2 col-md-4 col-6 mb-4">

                    <div class="movie-card">

                        <img src="https://picsum.photos/300/450?random=@i"
                             class="img-fluid">

                    </div>

                </div>
            }

        </div>

    </div>


    <div class="container-fluid movie-row">

        <h3>Popular Movies</h3>

        <div class="row">

            @for (int i = 7; i <= 12; i++)
            {
                <div class="col-lg-2 col-md-4 col-6 mb-4">

                    <div class="movie-card">

                        <img src="https://picsum.photos/300/450?random=@i"
                             class="img-fluid">

                    </div>

                </div>
            }

        </div>

    </div>


    <div class="container-fluid movie-row">

        <h3>Continue Watching</h3>

        <div class="row">

            @for (int i = 13; i <= 18; i++)
            {
                <div class="col-lg-2 col-md-4 col-6 mb-4">

                    <div class="movie-card">

                        <img src="https://picsum.photos/300/450?random=@i"
                             class="img-fluid">

                    </div>

                </div>
            }

        </div>

    </div>


    <footer class="footer text-center">

        <p>

            © 2026 StreamFlix

        </p>

        <p>

            Built with ASP.NET Core Razor Pages

        </p>

    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>